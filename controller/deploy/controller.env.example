# Copy to /etc/connectly-controller/controller.env (root:connectly, chmod 640).
# Never commit the real file. The database password is set by Phillip.

# local | staging | production. A non-production controller refuses the
# production database; production refuses anything else.
CONTROLLER_ENV=staging

# Supabase session pooler, logging in as the restricted controller role:
#   postgres://connectly_controller.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Supabase's database CA certificate (Database settings > SSL). Required outside local.
DATABASE_CA_FILE=/etc/connectly-controller/supabase-ca.crt

# Address routers dial for WireGuard. Use a DNS name so moving hosts needs no router change.
CONTROLLER_ENDPOINT=controller.getconnectly.net:51820
WG_PUBLIC_KEY_FILE=/etc/wireguard/connectly.pub
# Router peer list, applied to the hub by deploy/wg-peers-sync.sh (root).
WG_PEERS_FILE=/var/lib/connectly-controller/wg-peers.conf
# Bootstrap endpoint: the controller's tunnel address only, never a public address.
BOOTSTRAP_LISTEN=10.77.0.1:8080

CONTROLLER_DATA_DIR=/var/lib/connectly-controller
CONTROLLER_CONCURRENCY=2
