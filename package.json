{
  "name": "connectly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:controller": "cd controller && node --test --test-concurrency=1 test/*.test.ts",
    "cf:build": "node scripts/cf-guard.mjs && opennextjs-cloudflare build && node scripts/cf-static-pages.mjs && node scripts/cf-guard.mjs --built",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:size": "npm run cf:build && wrangler deploy --dry-run --outdir .open-next/dry-run"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.114.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.114.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.166.0"
  }
}
