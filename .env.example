# Copy to .env.local for local development. Set the same names in Vercel.
# Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://plydltvxfozxflarrfrx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # public anon key; safe in the browser now that RLS is on
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.

# --- Admin access ---
# Comma-separated Supabase Auth emails allowed into /admin and /api/admin.
# If empty, nobody can use the admin console (fail closed).
ADMIN_EMAILS=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # base for Korapay redirect + webhook URLs

# --- Korapay (use test keys outside production) ---
KORA_SECRET_KEY=

# --- Termii ---
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- Jobs and routers ---
CRON_SECRET=                 # Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"
NODE_HEARTBEAT_SECRET=       # pre-shared key routers send as x-connectly-node-key
NETWORK_MODE=mock            # mock | mikrotik
