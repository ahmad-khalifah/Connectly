# Cloudflare Workers static assets (copied into .open-next/assets by the build).
# Next.js script and style files have a content hash in their names, so a
# browser may keep them for a year without asking again. Everything else keeps
# Cloudflare's default (revalidate on every visit), so a deploy shows at once.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
